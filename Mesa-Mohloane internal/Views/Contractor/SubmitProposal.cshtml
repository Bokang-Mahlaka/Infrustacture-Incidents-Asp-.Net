@model Mesa_Mohloane_internal.Models.CreateProposalViewModel
@{
    ViewData["Title"] = "Draft Tender Proposal";
}

<div class="container section-padding pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <h2 class="fw-bold mb-4">Draft Tender Bidding</h2>
            <div class="clearbit-card shadow-sm">
                <form asp-action="SubmitProposal" method="post">
                    <input type="hidden" asp-for="IncidentId" />
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small fw-bold"></div>

                    <div class="form-floating mb-4">
                        <textarea asp-for="CoverLetter" class="form-control" placeholder="Details" style="height: 120px;"></textarea>
                        <label asp-for="CoverLetter" class="text-muted small">Justification & Approach</label>
                        <span asp-validation-for="CoverLetter" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <div class="form-floating mb-4">
                                <input asp-for="EstimatedDays" class="form-control" placeholder="10" type="number" />
                                <label asp-for="EstimatedDays" class="text-muted small">Turnaround (Days)</label>
                                <span asp-validation-for="EstimatedDays" class="text-danger small"></span>
                            </div>
                        </div>
                    <div class="mb-4">
                        <label class="text-heading fw-bold mb-3 d-block">Structured Financial Breakdown</label>
                        <div class="table-responsive border rounded overflow-hidden">
                            <table class="table table-sm align-middle mb-0" id="lineItemsTable">
                                <thead class="bg-light">
                                    <tr class="small text-muted fw-bold">
                                        <th class="ps-3 py-2" style="width: 25%;">Category</th>
                                        <th class="py-2" style="width: 40%;">Description</th>
                                        <th class="py-2" style="width: 10%;">Qty</th>
                                        <th class="py-2" style="width: 25%;">Unit Price (M)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.LineItems.Count; i++)
                                    {
                                        <tr>
                                            <td class="ps-3">
                                                <select asp-for="LineItems[i].Category" class="form-select form-select-sm border-0 bg-transparent">
                                                    <option value="0">Materials</option>
                                                    <option value="1">Labor</option>
                                                    <option value="2">Transport</option>
                                                    <option value="3">Equipment</option>
                                                    <option value="4">Other</option>
                                                </select>
                                            </td>
                                            <td>
                                                <input asp-for="LineItems[i].Description" class="form-control form-control-sm border-0 bg-transparent" placeholder="Item details..." />
                                            </td>
                                            <td>
                                                <input asp-for="LineItems[i].Quantity" class="form-control form-control-sm border-0 bg-transparent line-qty" type="number" min="1" />
                                            </td>
                                            <td>
                                                <input asp-for="LineItems[i].UnitPrice" class="form-control form-control-sm border-0 bg-transparent line-price" type="number" step="0.01" placeholder="0.00" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-3 text-end">
                            <h4 class="fw-extrabold text-brand mb-1" id="grandTotalDisplay">M0.00</h4>
                            <span class="text-muted small fw-bold">TOTAL TENDER VALUE</span>
                        </div>
                    </div>

                    <button type="submit" class="btn-brand w-100 py-3 mt-2 fw-bold" style="font-size: 1.1rem;">
                        Lock In Proposal <i data-lucide="lock" class="ms-2" style="width: 18px; height: 18px;"></i>
                    </button>
                    
                    <div class="text-center mt-3">
                        <a asp-action="Dashboard" class="text-muted small text-decoration-none">Cancel Draft</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const table = document.getElementById('lineItemsTable');
            const grandTotalDisplay = document.getElementById('grandTotalDisplay');

            function calculateGrandTotal() {
                let total = 0;
                const rows = table.querySelectorAll('tbody tr');
                rows.forEach(row => {
                    const qty = parseFloat(row.querySelector('.line-qty').value) || 0;
                    const price = parseFloat(row.querySelector('.line-price').value) || 0;
                    total += (qty * price);
                });
                grandTotalDisplay.textContent = 'M' + total.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            table.addEventListener('input', function (e) {
                if (e.target.classList.contains('line-qty') || e.target.classList.contains('line-price')) {
                    calculateGrandTotal();
                }
            });

            // Initial calculation
            calculateGrandTotal();
        });
    </script>
}
