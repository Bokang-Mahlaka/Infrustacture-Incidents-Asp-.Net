@{
    ViewData["Title"] = "Mesa Mohloane Infrastructure";
}

<div class="hero-gradient-overlay"></div>
<div class="dot-pattern"></div>

<!-- ===== HERO SECTION ===== -->
<section class="position-relative" style="padding: 7rem 0 5rem;">
    <div class="container">
        <div class="row align-items-center g-5">
            <!-- Left: Copy -->
            <div class="col-lg-6">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-4" style="background: rgba(79, 70, 229, 0.08); border: 1px solid rgba(79, 70, 229, 0.15);">
                    <span style="font-size: 0.7rem; font-weight: 700; color: var(--brand-primary); letter-spacing: 0.04em;">NEW</span>
                    <span style="font-size: 0.8rem; font-weight: 500; color: var(--text-body);">Verification Engine v2.0</span>
                    <i data-lucide="arrow-right" style="width: 14px; height: 14px; color: var(--brand-primary);"></i>
                </div>

                <h1 class="mb-4">
                    The bedrock of<br/>
                    <span class="text-gradient">predictable</span>
                    infrastructure.
                </h1>

                <p class="mb-5" style="max-width: 480px; font-size: 1.1rem; color: var(--text-body);">
                    Mesa Mohloane gives government agencies and citizens full transparency over shared infrastructure — ensuring every cent builds a stronger Lesotho.
                </p>

                <div class="d-flex align-items-center flex-wrap gap-3 mb-5">
                    <a class="btn-brand btn-brand-lg text-decoration-none" asp-controller="Auth" asp-action="Register">
                        Get Started Free
                    </a>
                    <a class="btn-brand-outline btn-brand-lg text-decoration-none d-flex align-items-center gap-2" href="#infrastructure">
                        <i data-lucide="play-circle" style="width: 18px; height: 18px;"></i>
                        Watch Demo
                    </a>
                </div>

                <!-- Social Proof -->
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex" style="margin-right: -8px;">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: #E0E7FF; border: 2px solid white; z-index: 3;">
                            <i data-lucide="user" style="width: 14px; height: 14px; color: var(--brand-primary);"></i>
                        </div>
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: #DDD6FE; border: 2px solid white; z-index: 2; margin-left: -8px;">
                            <i data-lucide="user" style="width: 14px; height: 14px; color: var(--brand-secondary);"></i>
                        </div>
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: #CFFAFE; border: 2px solid white; z-index: 1; margin-left: -8px;">
                            <i data-lucide="user" style="width: 14px; height: 14px; color: var(--brand-accent);"></i>
                        </div>
                    </div>
                    <div>
                        <span class="small fw-semibold" style="color: var(--text-heading);">2,400+ projects verified</span>
                        <span class="small text-muted ms-1">across Lesotho</span>
                    </div>
                </div>
            </div>

            <!-- Right: Product Card -->
            <div class="col-lg-6">
                <div class="hero-product-card">
                    <!-- Card Header -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background: linear-gradient(135deg, var(--brand-primary), var(--brand-secondary));">
                                <i data-lucide="bar-chart-3" class="text-white" style="width: 18px; height: 18px;"></i>
                            </div>
                            <div>
                                <div class="fw-bold" style="font-size: 0.95rem; color: var(--text-heading);">Verification Engine</div>
                                <div class="small" style="color: var(--text-muted);">Real-time audit</div>
                            </div>
                        </div>
                        <span class="d-inline-flex align-items-center gap-1 px-2 py-1 rounded-pill" style="background: #ECFDF5; border: 1px solid #A7F3D0; font-size: 0.7rem; font-weight: 600; color: #059669;">
                            <span style="width: 6px; height: 6px; background: #059669; border-radius: 50; display: inline-block;"></span>
                            LIVE
                        </span>
                    </div>

                    <!-- Mini Chart -->
                    <div class="rounded-3 p-4 mb-4" style="background: var(--bg-offwhite); border: 1px solid var(--border-subtle);">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="small fw-semibold" style="color: var(--text-heading);">Procurement Score</span>
                            <span class="small fw-bold" style="color: var(--brand-primary);">+12.4%</span>
                        </div>
                        <div class="d-flex align-items-end gap-1" style="height: 80px;">
                            <div class="flex-fill mini-bar" style="height: 35%; background: var(--brand-primary); opacity: 0.15;"></div>
                            <div class="flex-fill mini-bar" style="height: 55%; background: var(--brand-primary); opacity: 0.25;"></div>
                            <div class="flex-fill mini-bar" style="height: 45%; background: var(--brand-primary); opacity: 0.35;"></div>
                            <div class="flex-fill mini-bar" style="height: 70%; background: var(--brand-primary); opacity: 0.5;"></div>
                            <div class="flex-fill mini-bar" style="height: 60%; background: var(--brand-primary); opacity: 0.65;"></div>
                            <div class="flex-fill mini-bar" style="height: 85%; background: var(--brand-primary); opacity: 0.8;"></div>
                            <div class="flex-fill mini-bar" style="height: 95%; background: var(--brand-primary);"></div>
                        </div>
                    </div>

                    <!-- Stat Row -->
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <div class="rounded-3 p-3 text-center" style="background: var(--bg-offwhite); border: 1px solid var(--border-subtle);">
                                <div class="fw-extrabold" style="font-size: 1.75rem; color: var(--text-heading);">98.4<span style="font-size: 0.9rem; color: var(--text-muted);">%</span></div>
                                <div class="small text-muted fw-medium">Confidence</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="rounded-3 p-3 text-center" style="background: var(--bg-offwhite); border: 1px solid var(--border-subtle);">
                                <div class="fw-extrabold" style="font-size: 1.75rem; color: var(--text-heading);">M 1.2<span style="font-size: 0.9rem; color: var(--text-muted);">M</span></div>
                                <div class="small text-muted fw-medium">Disbursed</div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="d-flex align-items-center justify-content-between pt-3" style="border-top: 1px solid var(--border-light);">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; background: #ECFDF5;">
                                <i data-lucide="check" style="width: 12px; height: 12px; color: #059669;"></i>
                            </div>
                            <span class="small fw-semibold" style="color: var(--text-heading);">Algorithm Verified</span>
                        </div>
                        <span class="small" style="color: var(--text-muted); font-family: monospace; font-size: 0.75rem;">LS-90210</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== LOGO FARM ===== -->
<section class="py-5" style="border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);">
    <div class="container">
        <p class="text-center small fw-bold text-uppercase mb-4" style="letter-spacing: 0.15em; color: var(--text-muted); font-size: 0.7rem;">Trusted by innovative agencies</p>
        <div class="d-flex justify-content-center align-items-center flex-wrap gap-5">
            <span class="logo-farm-item">Segment</span>
            <span class="logo-farm-item">Asana</span>
            <span class="logo-farm-item">Intercom</span>
            <span class="logo-farm-item">Gong</span>
            <span class="logo-farm-item">HubSpot</span>
        </div>
    </div>
</section>

<!-- ===== FEATURE: CITIZEN REPORTING ===== -->
<section id="infrastructure" class="section-padding">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(79, 70, 229, 0.06); font-size: 0.75rem; font-weight: 700; color: var(--brand-primary); letter-spacing: 0.06em;">
                    CITIZEN FIRST
                </div>
                <h2 class="mb-4">Real-time fault reporting.<br/>Immutable audit trails.</h2>
                <p class="mb-4" style="font-size: 1.05rem;">
                    Empower your citizens to be the eyes of your infrastructure. Our platform captures precise GPS locations and photo evidence, automatically dispatching tasks to verified contractors.
                </p>
                <div class="row g-4 mb-4">
                    <div class="col-6">
                        <div class="d-flex align-items-start gap-2">
                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 28px; height: 28px; background: rgba(79, 70, 229, 0.08);">
                                <i data-lucide="map-pin" style="width: 14px; height: 14px; color: var(--brand-primary);"></i>
                            </div>
                            <div>
                                <div class="fw-bold small" style="color: var(--text-heading);">GPS Tagging</div>
                                <p class="small text-muted mb-0">Pinpoint precision for every report.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-start gap-2">
                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 28px; height: 28px; background: rgba(79, 70, 229, 0.08);">
                                <i data-lucide="camera" style="width: 14px; height: 14px; color: var(--brand-primary);"></i>
                            </div>
                            <div>
                                <div class="fw-bold small" style="color: var(--text-heading);">Photo Evidence</div>
                                <p class="small text-muted mb-0">Visual verification before work begins.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <a href="#" class="fw-semibold text-decoration-none d-flex align-items-center gap-2" style="color: var(--brand-primary);">
                    Explore infrastructure registry <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
                </a>
            </div>
            <div class="col-lg-6 offset-lg-1">
                <div class="clearbit-card border-0 p-0 overflow-hidden" style="border-radius: var(--radius-xl); background: linear-gradient(135deg, var(--bg-offwhite), #EEF2FF);">
                    <div class="d-flex flex-column align-items-center justify-content-center py-5" style="min-height: 340px;">
                        <div class="rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; background: rgba(79, 70, 229, 0.1);">
                            <i data-lucide="map-pin" style="width: 28px; height: 28px; color: var(--brand-primary);"></i>
                        </div>
                        <div class="fw-bold" style="color: var(--text-heading); font-size: 1.1rem;">Maseru Central</div>
                        <div class="small text-muted">District infrastructure map</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



<!-- ===== CTA ===== -->
<section class="section-padding">
    <div class="container">
        <div class="text-center py-5 px-4 rounded-4" style="background: var(--text-heading); border-radius: var(--radius-xl) !important;">
            <h2 class="text-white mb-3" style="letter-spacing: -0.02em;">Ready to digitize your infrastructure?</h2>
            <p class="text-white mb-5" style="opacity: 0.5;">Join the platform building the future of the Kingdom.</p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a class="btn-brand btn-brand-lg text-decoration-none" asp-controller="Auth" asp-action="Register">Get Started Free</a>
                <a class="btn-brand-outline btn-brand-lg text-decoration-none" href="#" style="border-color: rgba(255,255,255,0.2); color: white !important; background: transparent;">Contact Sales</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
    // Navbar scroll effect
    const navbar = document.getElementById('mainNavbar');
    if (navbar) {
        window.addEventListener('scroll', () => {
            navbar.classList.toggle('scrolled', window.scrollY > 20);
        });
    }

    // Hero card parallax on scroll
    const heroCard = document.querySelector('.hero-product-card');
    if (heroCard) {
        let rotation = -4;
        let targetRotation = -4;
        let lastY = window.scrollY;
        let raf;

        function animateCard() {
            rotation += (targetRotation - rotation) * 0.06;
            heroCard.style.transform = `perspective(1200px) rotateY(${rotation}deg) rotateX(2deg)`;
            if (Math.abs(targetRotation - rotation) > 0.01) {
                raf = requestAnimationFrame(animateCard);
            }
        }

        window.addEventListener('scroll', () => {
            const delta = window.scrollY - lastY;
            lastY = window.scrollY;
            targetRotation = Math.max(-12, Math.min(4, targetRotation + delta * 0.15));
            cancelAnimationFrame(raf);
            raf = requestAnimationFrame(animateCard);
        });
    }
    </script>
}
