@{
    ViewData["Title"] = "Mesa Mohloane Infrastructure";
}

<div class="hero-gradient-overlay"></div>
<div class="dot-pattern"></div>


<section class="position-relative" style="padding: 7rem 0 5rem;">
    <div class="container">
        <div class="row align-items-center g-5">
           
            <div class="col-lg-5" style="margin-left: -1.5rem;">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-4" style="background: rgba(0, 20, 137, 0.05); border: 1px solid rgba(0, 20, 137, 0.1);">
                    <span style="font-size: 0.7rem; font-weight: 800; color: var(--brand-primary); letter-spacing: 0.04em; text-transform: uppercase;">Kingdom of Lesotho</span>
                    <!-- <span style="width: 4px; height: 4px; background: var(--brand-secondary); border-radius: 50%;"></span> -->
                    <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-body);">National Infrastructure Portal</span>
                </div>

                <h1 class="mb-4">
                    The bedrock of<br/>
                    predictable<br/>
                    infrastructure.
                </h1>

                <p class="mb-5" style="max-width: 480px; font-size: 1.1rem; color: var(--text-body); line-height: 1.6;">
                    Providing a centralized framework for the monitoring and reporting of national infrastructure. Ensuring transparency and accountability in every public works project across the Kingdom.
                </p>

                <div class="d-flex align-items-center flex-wrap gap-3 mb-5">
                    <a class="btn-brand btn-brand-lg text-decoration-none" asp-controller="Auth" asp-action="Register">
                        Register Account
                    </a>
                    <a class="btn-brand-outline btn-brand-lg text-decoration-none d-flex align-items-center gap-2" href="#infrastructure">
                        <i data-lucide="info" style="width: 18px; height: 18px;"></i>
                        How it Works
                    </a>
                </div>

                <!-- Official Verification -->
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: rgba(0, 154, 68, 0.1); border: 1px solid rgba(0, 154, 68, 0.2);">
                        <i data-lucide="shield-check" style="width: 18px; height: 18px; color: var(--brand-secondary);"></i>
                    </div>
                    <div>
                        <span class="small fw-bold" style="color: var(--text-heading);">2,400+ Government Projects</span>
                        <div class="small text-muted">Centrally monitored and audited</div>
                    </div>
                </div>
            </div>

            <!-- Right: Product Card -->
            <!-- Right: Hero Carousel -->
            <div class="col-lg-7">
                <div id="infrastructureCarousel" class="carousel slide clearbit-card border-0 p-0 overflow-hidden shadow-xl hero-product-card" data-bs-ride="carousel" data-bs-interval="5000" style="border-radius: var(--radius-xl); transform: perspective(1200px) rotateY(-4deg) rotateX(2deg); padding: 0 !important; margin-left: -2rem;">
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#infrastructureCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                        <button type="button" data-bs-target="#infrastructureCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                        <button type="button" data-bs-target="#infrastructureCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
                    </div>
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="~/images/scapers.jpg" class="d-block w-100" alt="Maseru Town" style="object-fit: cover; height: 600px;">
                            <div class="carousel-caption d-none d-md-block" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(8px); bottom: 0; left: 0; right: 0; padding: 1.5rem; text-align: left;">
                                <h5 class="fw-bold text-white mb-1">Maseru Infrastructure</h5>
                                <p class="small text-white-50 mb-0">National oversight and asset management.</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/bust.png" class="d-block w-100" alt="Lesotho Flag Heritage" style="object-fit: cover; height: 600px;">
                            <div class="carousel-caption d-none d-md-block" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(8px); bottom: 0; left: 0; right: 0; padding: 1.5rem; text-align: left;">
                                <h5 class="fw-bold text-white mb-1">Reported Incidents</h5>
                                <p class="small text-white-50 mb-0">Building the future of the Kingdom.</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/blueprint.png" class="d-block w-100" alt="Infrastructure Blueprint" style="object-fit: cover; height: 600px;">
                            <div class="carousel-caption d-none d-md-block" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(8px); bottom: 0; left: 0; right: 0; padding: 1.5rem; text-align: left;">
                                <h5 class="fw-bold text-white mb-1">Strategic Planning</h5>
                                <p class="small text-white-50 mb-0">Precision engineering for sustainable development.</p>
                            </div>
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#infrastructureCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#infrastructureCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== LOGO FARM ===== -->
<section class="py-5" style="border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);">
    <div class="container">
        <p class="text-center small fw-bold text-uppercase mb-4" style="letter-spacing: 0.15em; color: var(--text-muted); font-size: 0.7rem;">Official Oversight & Infrastructure Partners</p>
        <div class="d-flex justify-content-center align-items-center flex-wrap gap-5">
            <span class="logo-farm-item">Roads Directorate</span>
            <span class="logo-farm-item">LHDA</span>
            <span class="logo-farm-item">WASCO</span>
            <span class="logo-farm-item">LEC</span>
            <span class="logo-farm-item">LNDC</span>
        </div>
    </div>
</section>

<!-- ===== FEATURE: CITIZEN REPORTING ===== -->
<section id="infrastructure" class="section-padding">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(0, 154, 68, 0.06); font-size: 0.75rem; font-weight: 700; color: var(--brand-primary); letter-spacing: 0.06em;">
                    PUBLIC REPORTING
                </div>
                <h2 class="mb-4">Transparent incident reporting.<br/>Immutable audit trails.</h2>
                <p class="mb-4" style="font-size: 1.05rem;">
                    Empower your citizens to be the eyes of your infrastructure. Our platform captures precise GPS locations and photo evidence, automatically dispatching tasks to verified contractors.
                </p>
                <div class="row g-4 mb-4">
                    <div class="col-6">
                        <div class="d-flex align-items-start gap-2">
                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 28px; height: 28px; background: rgba(0, 154, 68, 0.08);">
                                <i data-lucide="map-pin" style="width: 14px; height: 14px; color: var(--brand-primary);"></i>
                            </div>
                            <div>
                                <div class="fw-bold small" style="color: var(--text-heading);">GPS Tagging</div>
                                <p class="small text-muted mb-0">Pinpoint precision for every report.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-start gap-2">
                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 28px; height: 28px; background: rgba(0, 154, 68, 0.08);">
                                <i data-lucide="camera" style="width: 14px; height: 14px; color: var(--brand-primary);"></i>
                            </div>
                            <div>
                                <div class="fw-bold small" style="color: var(--text-heading);">Photo Evidence</div>
                                <p class="small text-muted mb-0">Visual verification before work begins.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <a href="#" class="fw-semibold text-decoration-none d-flex align-items-center gap-2" style="color: var(--brand-primary);">
                    Explore infrastructure registry <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
                </a>
            </div>
            <div class="col-lg-6 offset-lg-1">
                <div class="clearbit-card border-0 p-0 overflow-hidden shadow-lg" style="border-radius: var(--radius-xl);">
                    <img src="~/images/town.jpg" alt="Infrastructure in Lesotho" class="img-fluid w-100 h-100" style="object-fit: cover; min-height: 400px; display: block;" />
                </div>
            </div>
        </div>
    </div>
</section>



<!-- ===== CTA ===== -->
<section class="section-padding">
    <div class="container">
        <div class="text-center py-5 px-4 rounded-4" style="background: var(--text-heading); border-radius: var(--radius-xl) !important;">
            <h2 class="text-white mb-3" style="letter-spacing: -0.02em;">Contribute to National Development</h2>
            <p class="text-white mb-5" style="opacity: 0.7;">Join the official initiative ensuring transparency and excellence in Lesotho's infrastructure.</p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a class="btn-brand btn-brand-lg text-decoration-none" asp-controller="Auth" asp-action="Register">Register Account</a>
                <a class="btn-brand-outline btn-brand-lg text-decoration-none" href="#" style="border-color: rgba(255,255,255,0.2); color: white !important; background: transparent;">Contact us</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
    // Navbar scroll effect
    const navbar = document.getElementById('mainNavbar');
    if (navbar) {
        window.addEventListener('scroll', () => {
            navbar.classList.toggle('scrolled', window.scrollY > 20);
        });
    }

    // Initialize Bootstrap Carousel manually to ensure it starts
    document.addEventListener('DOMContentLoaded', function () {
        var myCarousel = document.querySelector('#infrastructureCarousel');
        if (myCarousel) {
            new bootstrap.Carousel(myCarousel, {
                interval: 5000,
                ride: 'carousel'
            });
        }
    });

    // Hero card parallax on scroll
    const heroCard = document.querySelector('.hero-product-card');
    if (heroCard) {
        let rotation = -4;
        let targetRotation = -4;
        let lastY = window.scrollY;
        let raf;

        function animateCard() {
            rotation += (targetRotation - rotation) * 0.06;
            heroCard.style.transform = `perspective(1200px) rotateY(${rotation}deg) rotateX(2deg)`;
            if (Math.abs(targetRotation - rotation) > 0.01) {
                raf = requestAnimationFrame(animateCard);
            }
        }

        window.addEventListener('scroll', () => {
            const delta = window.scrollY - lastY;
            lastY = window.scrollY;
            targetRotation = Math.max(-12, Math.min(4, targetRotation + delta * 0.15));
            cancelAnimationFrame(raf);
            raf = requestAnimationFrame(animateCard);
        });
    }
    </script>
}
