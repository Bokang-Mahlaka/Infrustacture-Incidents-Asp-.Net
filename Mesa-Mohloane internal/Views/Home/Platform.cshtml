@{
    var subTopic = ViewData["SubTopic"] as string ?? "registry";
    ViewData["Title"] = subTopic.ToUpper() + " - Mesa Mohloane Platform";
    
    var title = "Infrastructure Registry";
    var description = "A centralized, immutable database of all public infrastructure assets in the Kingdom of Lesotho.";
    var icon = "layers";
    
    if(subTopic == "verification") {
        title = "Verification Engine";
        description = "Automated auditing and algorithmic verification of procurement and project milestones.";
        icon = "shield-check";
    } else if(subTopic == "reporting") {
        title = "Citizen Reporting";
        description = "Public engagement portal for reporting infrastructure faults with photographic evidence and GPS tagging.";
        icon = "file-text";
    }
}

<div class="hero-gradient-overlay"></div>
<div class="dot-pattern"></div>

<section class="section-padding position-relative">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
                <li class="breadcrumb-item"><span class="text-muted">Platform</span></li>
                <li class="breadcrumb-item active" aria-current="page">@title</li>
            </ol>
        </nav>

        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-4" style="background: rgba(0, 20, 137, 0.05); border: 1px solid rgba(0, 20, 137, 0.1);">
                    <span style="font-size: 0.7rem; font-weight: 800; color: var(--brand-primary); letter-spacing: 0.04em; text-transform: uppercase;">Platform Component</span>
                </div>
                <h1 class="display-4 fw-bold mb-4" style="color: var(--text-heading);">
                    <i data-lucide="@icon" class="me-3" style="width: 48px; height: 48px; color: var(--brand-primary);"></i><br/>
                    @title
                </h1>
                <p class="lead text-muted mb-5" style="line-height: 1.8;">
                    @description This component is a critical part of the National Infrastructure Portal, ensuring that every project is tracked from inception to completion with absolute transparency.
                </p>
                
                <div class="card border-0 shadow-sm p-4 mb-5" style="background: rgba(255,255,255,0.8); backdrop-filter: blur(10px); border-radius: var(--radius-lg);">
                    <h5 class="fw-bold mb-3">Key Capabilities</h5>
                    <ul class="list-unstyled">
                        <li class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle bg-success bg-opacity-10 p-2">
                                <i data-lucide="check" style="width: 16px; height: 16px; color: #059669;"></i>
                            </div>
                            <span class="text-muted">Immutable Audit Logs</span>
                        </li>
                        <li class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle bg-success bg-opacity-10 p-2">
                                <i data-lucide="check" style="width: 16px; height: 16px; color: #059669;"></i>
                            </div>
                            <span class="text-muted">Real-time Resource Tracking</span>
                        </li>
                        <li class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-success bg-opacity-10 p-2">
                                <i data-lucide="check" style="width: 16px; height: 16px; color: #059669;"></i>
                            </div>
                            <span class="text-muted">Stakeholder Accountability</span>
                        </li>
                    </ul>
                </div>
                
                <a asp-controller="Auth" asp-action="Register" class="btn-brand btn-brand-lg text-decoration-none">Register for Access</a>
            </div>
            
            <div class="col-lg-6">
                <div class="clearbit-card border-0 p-0 overflow-hidden shadow-xl" style="border-radius: var(--radius-xl);">
                    <img src="~/images/town.jpg" class="img-fluid w-100" alt="@title" style="object-fit: cover; height: 500px; filter: grayscale(20%);">
                </div>
            </div>
        </div>
    </div>
</section>
