@model Mesa_Mohloane_internal.Models.IncidentViewModel
@{
    ViewData["Title"] = "Incident Details — " + Model.Title;
}

<div class="container section-padding">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-brand text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">#@Model.Id</li>
        </ol>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i data-lucide="check-circle" class="me-2" style="width: 18px; height: 18px;"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i data-lucide="alert-circle" class="me-2" style="width: 18px; height: 18px;"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Main Content -->
        <div class="col-lg-8">
            <div class="clearbit-card shadow-sm mb-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="badge" style="background: var(--bg-offwhite); color: var(--text-heading); border: 1px solid var(--border-light); font-size: 0.9rem;">
                        <i data-lucide="tag" class="me-1" style="width: 14px; height: 14px;"></i> @Model.Category
                    </span>
                    <span class="text-muted small fw-bold">REF: MS-@Model.Id-2026</span>
                </div>

                <h1 class="fw-extrabold text-heading mb-4">@Model.Title</h1>

                <!-- MAP FIRST - Primary Focus -->
                @if (Model.Latitude != 0 && Model.Longitude != 0)
                {
                    <div class="mb-5">
                        <h5 class="fw-bold mb-3 d-flex align-items-center">
                            <i data-lucide="map" class="text-brand me-2" style="width: 20px; height: 20px;"></i>
                            Incident Location Map
                        </h5>
                        <div id="incidentMap" style="height: 500px; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.1); border: 2px solid var(--border-light);"></div>
                    </div>
                }

                <!-- Location Details Below Map -->
                <div class="d-flex align-items-center mb-4 pb-4 border-bottom">
                    <div class="bg-light p-3 rounded-circle me-3">
                        <i data-lucide="map-pin" class="text-brand" style="width: 24px; height: 24px;"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Location</h6>
                        <p class="text-muted mb-0">@Model.Location</p>
                        @if (Model.Latitude != 0 && Model.Longitude != 0)
                        {
                            <p class="text-muted small mb-0">GPS: @Model.Latitude.ToString("F6"), @Model.Longitude.ToString("F6")</p>
                        }
                    </div>
                </div>

                <div class="mb-5">
                    <h5 class="fw-bold mb-3 d-flex align-items-center">
                        <i data-lucide="info" class="text-brand me-2" style="width: 20px; height: 20px;"></i>
                        Detailed Description
                    </h5>
                    <p class="text-secondary lead" style="line-height: 1.8;">@Model.Description</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                {
                    <div class="mb-2">
                        <h5 class="fw-bold mb-3 d-flex align-items-center">
                            <i data-lucide="camera" class="text-brand me-2" style="width: 20px; height: 20px;"></i>
                            Photo Evidence
                        </h5>
                        <div class="rounded-4 overflow-hidden shadow-sm border">
                            <img src="@Model.PhotoUrl" alt="Incident Photo" class="img-fluid w-100" style="max-height: 500px; object-fit: cover;" />
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar / Status -->
        <div class="col-lg-4">
            <!-- Status Card -->
            <div class="clearbit-card shadow-sm mb-4" style="border-left: 4px solid var(--brand-primary);">
                <h6 class="text-uppercase ls-1 fw-bold text-muted small mb-4">Incident Status</h6>
                <div class="d-flex align-items-center mb-3">
                    <div class="status-dot @(Model.Status == "Completed" ? "bg-success" : "bg-warning") me-2" style="width: 10px; height: 10px; border-radius: 50%;"></div>
                    <span class="fw-extrabold text-heading">@Model.Status</span>
                </div>
                <div class="small text-muted py-3 border-top border-bottom mb-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Reported On:</span>
                        <span class="text-dark fw-bold">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Proposals:</span>
                        <span class="text-dark fw-bold">@Model.ProposalCount</span>
                    </div>
                </div>

                @if (Model.Status == "Completed" && !Model.IsAcknowledged)
                {
                    <a asp-action="AcknowledgeWork" asp-route-incidentId="@Model.Id" class="btn btn-brand w-100 py-3 fw-bold">
                        <i data-lucide="check-circle" class="me-2" style="width: 18px; height: 18px;"></i>
                        Verify & Acknowledge Work
                    </a>
                }
                else if (Model.Status == "Completed" && Model.IsAcknowledged)
                {
                    <div class="alert alert-success mb-0">
                        <i data-lucide="check-circle" class="me-2" style="width: 16px; height: 16px;"></i>
                        Work Acknowledged
                    </div>
                }

                @if (Model.Status == "Reported" || Model.Status == "Verified")
                {
                    <p class="small text-muted mt-3 mb-0">
                        <i data-lucide="clock" class="me-1" style="width: 12px; height: 12px;"></i>
                        Your report is being reviewed. You'll be notified when contractors start bidding.
                    </p>
                }
            </div>

            <!-- Back Button -->
            <a asp-action="Dashboard" class="btn btn-outline-secondary w-100 py-3 fw-bold">
                <i data-lucide="arrow-left" class="me-2" style="width: 18px; height: 18px;"></i>
                Back to Dashboard
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Initialize map if GPS coordinates are available
        @if (Model.Latitude != 0 && Model.Longitude != 0)
        {
            <text>
        function initializeMap() {
            console.log('Initializing map...');
            console.log('Leaflet available:', typeof L !== 'undefined');

            // Check if Leaflet is loaded
            if (typeof L === 'undefined') {
                console.error('Leaflet.js not loaded yet, retrying...');
                setTimeout(initializeMap, 200);
                return;
            }

            const mapContainer = document.getElementById('incidentMap');
            if (!mapContainer) {
                console.error('Map container not found');
                return;
            }

            // Ensure container has proper dimensions
            console.log('Map container found, size:', mapContainer.offsetWidth, 'x', mapContainer.offsetHeight);

            try {
                // Initialize the map with proper options
                const map = L.map('incidentMap', {
                    center: [@Model.Latitude, @Model.Longitude],
                    zoom: 15,
                    scrollWheelZoom: true
                });

                console.log('Map object created');

                // Add OpenStreetMap tiles with crossOrigin
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap contributors',
                    maxZoom: 19,
                    crossOrigin: true
                }).addTo(map);

                console.log('Tiles loaded');

                // Add a marker at the incident location
                const marker = L.marker([@Model.Latitude, @Model.Longitude], {
                    title: '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.Title))'
                }).addTo(map);
                
                // Set marker popup with incident details
                marker.bindPopup(`
                    <div style="font-size: 13px; width: 200px;">
                        <strong style="color: var(--brand-primary);">@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.Title))</strong><br/>
                        <small style="color: #666;">📍 @Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.Location))</small><br/>
                        <small style="color: #999;">@Model.Latitude.ToString("F6")°, @Model.Longitude.ToString("F6")°</small>
                    </div>
                `);

                // Open popup automatically
                marker.openPopup();

                console.log('Map initialized successfully! Coordinates: @Model.Latitude, @Model.Longitude');

            } catch(error) {
                console.error('Error initializing map:', error);
            }
        }

        // Wait for DOM and Leaflet to be ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
                console.log('DOM loaded, initializing map in 300ms');
                setTimeout(initializeMap, 300);
            });
        } else {
            console.log('DOM already loaded, initializing map in 300ms');
            setTimeout(initializeMap, 300);
        }
            </text>
        }
    </script>
    <style>
        #incidentMap {
            width: 100% !important;
            height: 500px !important;
            position: relative !important;
        }
        
        .leaflet-container {
            background: #f0f0f0;
            font-family: inherit;
        }
        
        .leaflet-popup-content-wrapper {
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }
    </style>
}
}