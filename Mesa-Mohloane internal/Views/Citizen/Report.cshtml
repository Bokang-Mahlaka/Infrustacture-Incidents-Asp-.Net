@model Mesa_Mohloane_internal.Models.CreateIncidentViewModel
@{
    ViewData["Title"] = "Report Infrastructure Issue";
}

<div class="container section-padding pb-5">
    <div class="row">
        <!-- Z-Pattern Graphic Left -->
        <div class="col-lg-5 order-2 order-lg-1 mt-5 mt-lg-0">
            <div class="d-flex flex-column gap-4 h-100">
                <!-- Hero Illustration Card -->
                <div class="db-card border-0 shadow-sm overflow-hidden" style="background: linear-gradient(135deg, #001489 0%, #001e89 100%);">
                    <div class="p-4 pb-0 text-center text-white">
                        <h5 class="fw-bold mb-2 text-white">Institutional Intelligence</h5>
                        <p class="small text-white-50">Every report strengthens our national infrastructure grid.</p>
                    </div>
                    <img src="~/images/infrastructure_reporting_hero.png" class="img-fluid w-100" style="margin-top: -10px; opacity: 0.95;" />
                </div>

                <!-- Damage Grid & Map Card -->
                <div class="db-card border-0 shadow-sm p-4 bg-white">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="small fw-bold mb-2 text-muted text-uppercase" style="letter-spacing: 0.05em; font-size: 0.65rem;">Visual Database</div>
                            <img src="~/images/infrastructure_damage_collage.png" class="img-fluid rounded-3 shadow-sm border" />
                        </div>
                        <div class="col-6">
                            <div class="small fw-bold mb-2 text-muted text-uppercase" style="letter-spacing: 0.05em; font-size: 0.65rem;">Live Incident Map</div>
                            <img src="~/images/map_preview_pins.png" class="img-fluid rounded-3 shadow-sm border" />
                        </div>
                    </div>
                    
                    <hr class="my-4 opacity-10" />

                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex gap-3 align-items-center">
                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; flex-shrink: 0;">
                                <i data-lucide="camera" class="text-brand" style="width: 16px; height: 16px;"></i>
                            </div>
                            <div>
                                <div class="small fw-bold">Attach Visual Evidence</div>
                                <p class="x-small text-muted m-0">Photos help contractors quote more accurately.</p>
                            </div>
                        </div>
                        <div class="d-flex gap-3 align-items-center">
                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; flex-shrink: 0;">
                                <i data-lucide="map-pin" class="text-brand" style="width: 16px; height: 16px;"></i>
                            </div>
                            <div>
                                <div class="small fw-bold">Geographic Precision</div>
                                <p class="x-small text-muted m-0">Pin the exact location for field teams.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6 offset-lg-1 order-1 order-lg-2">
            <h2 class="fw-bold mb-4">Report an issue.</h2>
            <div class="clearbit-card shadow-sm">
                <form asp-action="Report" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small fw-bold"></div>

                    <div class="form-floating mb-4">
                        <input asp-for="Title" class="form-control" placeholder="Fallen Pole" />
                        <label asp-for="Title" class="text-muted small">Summary of Damage</label>
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-4">
                        <label asp-for="Category" class="text-heading fw-bold small mb-2">Issue Category</label>
                        <select asp-for="Category" class="form-select form-control text-muted" style="height: auto;">
                            <option value="Road">Road / Pothole</option>
                            <option value="Water">Water / Burst Pipe</option>
                            <option value="Electricity">Electricity / Pole</option>
                            <option value="Other">Other Civic Property</option>
                        </select>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Location" class="form-control" placeholder="Maseru West" />
                        <label asp-for="Location" class="text-muted small">Exact Location (Village/Street)</label>
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>

                    <!-- GPS Coordinates Integration -->
                    <input type="hidden" asp-for="Latitude" id="latitudeInput" />
                    <input type="hidden" asp-for="Longitude" id="longitudeInput" />
                    
                    <div class="mb-4">
                        <!-- GPS Status Bar -->
                        <div class="p-3 border rounded-3 mb-2" style="background-color: #f8f9fa;">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <i data-lucide="map-pin" class="text-primary" style="width: 18px; height: 18px;"></i>
                                    <span class="small fw-bold">GPS Location</span>
                                </div>
                                <span class="badge bg-secondary" id="gpsStatus">
                                    <i data-lucide="loader" class="me-1" style="width: 12px; height: 12px;"></i> Locating...
                                </span>
                            </div>
                            <p class="small text-muted mt-2 mb-0" id="gpsCoords">Detecting your location...</p>
                        </div>

                        <!-- Show Map Toggle Button -->
                        <button type="button" class="btn btn-outline-primary w-100 py-2" id="toggleMapBtn" onclick="toggleMap()">
                            <i data-lucide="map" class="me-2" style="width: 16px; height: 16px;"></i>
                            <span id="toggleMapText">Show Map to Pin Location</span>
                        </button>

                        <!-- Leaflet Map Container (hidden by default) -->
                        <div id="mapWrapper" style="display: none; margin-top: 12px;">
                            <div id="incidentMap" style="height: 320px; border-radius: 12px; border: 2px solid #e5e7eb; z-index: 1;"></div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <p class="small text-muted mb-0" id="mapHelp">Click on the map to set the incident location. Drag the pin to adjust.</p>
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="locateMe()" title="Re-detect my GPS location">
                                    <i data-lucide="locate" style="width: 14px; height: 14px;"></i> My Location
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-4">
                        <textarea asp-for="Description" class="form-control" placeholder="Details" style="height: 120px;"></textarea>
                        <label asp-for="Description" class="text-muted small">Detailed Description of the Problem</label>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="text-heading fw-bold small mb-2">Photo Evidence (Optional)</label>
                        <div class="border border-2 border-dashed rounded-3 p-4 text-center" id="photoDropZone" style="border-color: #6c757d !important;">
                            <input type="file" asp-for="Photo" accept="image/jpeg,image/png,image/gif,image/webp" class="d-none" id="photoInput" onchange="previewPhoto(this)" />
                            <label for="photoInput" class="w-100 text-center p-4 cursor-pointer mb-0">
                                <i data-lucide="camera" class="text-muted mb-2" style="width: 32px; height: 32px;"></i>
                                <p class="text-muted small mb-0">Click to upload or drag and drop</p>
                                <p class="text-muted small">JPG, PNG, GIF or WebP (max 5MB)</p>
                            </label>
                        </div>
                        <div id="photoPreview" class="mt-2 d-none">
                            <img id="previewImage" src="" alt="Preview" class="img-fluid rounded" style="max-height: 200px; object-fit: cover;" />
                            <button type="button" class="btn btn-sm btn-outline-danger mt-2" onclick="removePhoto()">Remove Photo</button>
                        </div>
                    </div>

                    <button type="submit" class="btn-brand w-100 py-3 mt-2 fw-bold" style="font-size: 1.1rem;">
                        Submit Report <i data-lucide="arrow-right" class="ms-2" style="width: 18px; height: 18px;"></i>
                    </button>
                    
                    <div class="text-center mt-3">
                        <a asp-action="Dashboard" class="text-muted small text-decoration-none">Back to Dashboard</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // ========================
        // PHOTO PREVIEW
        // ========================
        function previewPhoto(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('previewImage').src = e.target.result;
                    document.getElementById('photoPreview').classList.remove('d-none');
                    document.getElementById('photoDropZone').classList.add('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function removePhoto() {
            document.getElementById('photoInput').value = '';
            document.getElementById('previewImage').src = '';
            document.getElementById('photoPreview').classList.add('d-none');
            document.getElementById('photoDropZone').classList.remove('d-none');
        }

        // ========================
        // LEAFLET MAP + GPS
        // ========================
        var map = null;
        var marker = null;
        var mapVisible = false;
        var capturedLat = null;
        var capturedLng = null;

        // Default center: Maseru, Lesotho
        var defaultLat = -29.3151;
        var defaultLng = 27.4869;
        var defaultZoom = 13;

        // Marker icon (defined once)
        var markerIcon = null;

        function toggleMap() {
            var wrapper = document.getElementById('mapWrapper');
            var btn = document.getElementById('toggleMapBtn');
            var btnText = document.getElementById('toggleMapText');

            if (!mapVisible) {
                // Show the map
                wrapper.style.display = 'block';
                btnText.textContent = 'Hide Map';
                btn.classList.remove('btn-outline-primary');
                btn.classList.add('btn-primary');
                mapVisible = true;

                // Initialize map only on first show
                if (!map) {
                    setTimeout(function() {
                        initMap();
                    }, 100);
                } else {
                    // If map already exists, just invalidate size
                    setTimeout(function() {
                        map.invalidateSize();
                    }, 100);
                }
            } else {
                // Hide the map
                wrapper.style.display = 'none';
                btnText.textContent = 'Show Map to Pin Location';
                btn.classList.remove('btn-primary');
                btn.classList.add('btn-outline-primary');
                mapVisible = false;
            }

            lucide.createIcons();
        }

        function initMap() {
            var startLat = capturedLat || defaultLat;
            var startLng = capturedLng || defaultLng;
            var startZoom = capturedLat ? 15 : defaultZoom;

            map = L.map('incidentMap').setView([startLat, startLng], startZoom);

            // OpenStreetMap tile layer
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                maxZoom: 19
            }).addTo(map);

            // Define marker icon
            markerIcon = L.icon({
                iconUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon.png',
                iconRetinaUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon-2x.png',
                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41],
                popupAnchor: [1, -34],
                shadowSize: [41, 41]
            });

            // Click on map to place/move marker
            map.on('click', function(e) {
                placeMarker(e.latlng.lat, e.latlng.lng);
            });

            // If GPS was already captured before map opened, place marker
            if (capturedLat && capturedLng) {
                placeMarker(capturedLat, capturedLng);
            }

            // Force tile refresh after a brief delay
            setTimeout(function() {
                map.invalidateSize();
            }, 250);
        }

        function placeMarker(lat, lng) {
            if (!map) return;

            if (marker) {
                marker.setLatLng([lat, lng]);
            } else {
                marker = L.marker([lat, lng], { icon: markerIcon, draggable: true }).addTo(map);

                // Update coords when marker is dragged
                marker.on('dragend', function(e) {
                    var pos = e.target.getLatLng();
                    updateCoordinates(pos.lat, pos.lng);
                });
            }

            marker.bindPopup('<strong>Incident Location</strong><br>Drag me to adjust').openPopup();
            map.setView([lat, lng], Math.max(map.getZoom(), 15));
            updateCoordinates(lat, lng);
        }

        function updateCoordinates(lat, lng) {
            capturedLat = lat;
            capturedLng = lng;

            document.getElementById('latitudeInput').value = lat;
            document.getElementById('longitudeInput').value = lng;

            var statusBadge = document.getElementById('gpsStatus');
            var coordsDisplay = document.getElementById('gpsCoords');

            statusBadge.className = 'badge bg-success';
            statusBadge.innerHTML = '<i data-lucide="check-circle" class="me-1" style="width: 12px; height: 12px;"></i> Captured';
            coordsDisplay.textContent = 'Latitude: ' + lat.toFixed(6) + '\u00B0 | Longitude: ' + lng.toFixed(6) + '\u00B0';
            lucide.createIcons();
        }

        function captureGPSLocation() {
            var statusBadge = document.getElementById('gpsStatus');
            var coordsDisplay = document.getElementById('gpsCoords');

            if (!navigator.geolocation) {
                statusBadge.className = 'badge bg-warning';
                statusBadge.innerHTML = '<i data-lucide="alert-triangle" class="me-1" style="width: 12px; height: 12px;"></i> N/A';
                coordsDisplay.textContent = 'Geolocation not supported. Use the map to set location.';
                lucide.createIcons();
                return;
            }

            statusBadge.className = 'badge bg-secondary';
            statusBadge.innerHTML = '<i data-lucide="loader" class="me-1" style="width: 12px; height: 12px;"></i> Locating...';
            coordsDisplay.textContent = 'Detecting your location...';
            lucide.createIcons();

            navigator.geolocation.getCurrentPosition(
                function(position) {
                    var lat = position.coords.latitude;
                    var lng = position.coords.longitude;
                    
                    // Store coordinates
                    updateCoordinates(lat, lng);

                    // If map is already visible, place marker
                    if (map) {
                        placeMarker(lat, lng);
                    }
                },
                function(error) {
                    statusBadge.className = 'badge bg-warning';
                    statusBadge.innerHTML = '<i data-lucide="alert-triangle" class="me-1" style="width: 12px; height: 12px;"></i> Manual';
                    
                    var errorMessages = {
                        1: 'Location denied. Use the map button below to pin manually.',
                        2: 'Location unavailable. Use the map button below to pin manually.',
                        3: 'Location timed out. Use the map button below to pin manually.'
                    };
                    
                    coordsDisplay.textContent = errorMessages[error.code] || 'Use the map to set location.';
                    lucide.createIcons();
                },
                {
                    enableHighAccuracy: true,
                    timeout: 10000,
                    maximumAge: 0
                }
            );
        }

        function locateMe() {
            captureGPSLocation();
        }

        // Auto-capture GPS on page load (no map yet, just coordinates)
        document.addEventListener('DOMContentLoaded', function() {
            captureGPSLocation();
        });
    </script>
}
