@model List<Mesa_Mohloane_internal.Models.AuditLogViewModel>
@{
    ViewData["Title"] = "System Integrity Logs";
}

<div class="container section-padding">
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-4">
        <div>
            <h2 class="fw-bold mb-1">Audit Trail</h2>
            <p class="text-muted">Immutable record of all administrative and financial actions.</p>
        </div>
        <div>
            <button class="btn btn-outline-secondary btn-sm" onclick="exportLogs('csv')">
                <i data-lucide="download" class="me-2" style="width: 16px; height: 16px;"></i> Export CSV
            </button>
            <button class="btn btn-outline-secondary btn-sm" onclick="exportLogs('pdf')">
                <i data-lucide="file-pdf" class="me-2" style="width: 16px; height: 16px;"></i> Export PDF
            </button>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="clearbit-card shadow-sm p-0 overflow-hidden">
            <table class="table table-hover mb-0" style="font-size: 0.9rem;">
                <thead style="background: var(--bg-offwhite);">
                    <tr>
                        <th class="ps-4 py-3">Timestamp</th>
                        <th class="py-3">User</th>
                        <th class="py-3">Action</th>
                        <th class="py-3">Resource</th>
                        <th class="py-3">IP Address</th>
                        <th class="py-3 pe-4">Details</th>
                    </tr>
                </thead>
                <tbody class="align-middle">
                    @foreach(var log in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="text-muted">@log.Timestamp.ToString("yyyy-MM-dd")</span><br/>
                                <strong class="text-dark">@log.Timestamp.ToString("HH:mm:ss")</strong>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary-soft text-primary rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 24px; height: 24px; font-size: 0.7rem; font-weight: bold;">
                                        @(log.UserName?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <span>@log.UserName</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge @(log.Action.Contains("Rejected") || log.Action.Contains("Flag") ? "bg-danger-soft text-danger" : "bg-primary-soft text-primary")">
                                    @log.Action
                                </span>
                            </td>
                            <td>
                                <span class="text-capitalize">@log.Entity</span>
                                <small class="text-muted d-block">ID: #@log.EntityId</small>
                            </td>
                            <td><code>@log.IpAddress</code></td>
                            <td class="pe-4">
                                @if(!string.IsNullOrEmpty(log.NewValue))
                                {
                                    <span class="text-truncate d-block" style="max-width: 200px;" title="@log.NewValue">
                                        @log.NewValue
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<script>
function exportLogs(format) {
    const startDate = document.getElementById('filterStartDate')?.value;
    const endDate = document.getElementById('filterEndDate')?.value;
    const entity = document.getElementById('filterEntity')?.value;

    let url = `/Auditor/ExportAudit?format=${format}`;
    if (startDate) url += `&startDate=${startDate}`;
    if (endDate) url += `&endDate=${endDate}`;
    if (entity) url += `&entity=${entity}`;

    window.location.href = url;
}
</script>
