@model List<Mesa_Mohloane_internal.Models.InvoiceViewModel>
@{
    ViewData["Title"] = "Risk Analysis - Flagged Invoices";
}

<div class="container section-padding">
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-4">
        <div>
            <h2 class="fw-bold mb-1">Risk Flags</h2>
            <p class="text-muted">High-priority review of invoices with significant cost deviations.</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach(var item in Model)
            {
                <div class="col-lg-12 mb-4">
                    <div class="clearbit-card border-danger shadow-sm d-flex justify-content-between align-items-center">
                        <div style="flex-grow: 1;">
                            <div class="d-flex align-items-center mb-2">
                                <span class="badge bg-danger text-white me-3">CRITICAL DEVIATION</span>
                                <span class="text-muted small">Submitted @item.SubmittedAt.ToString("g")</span>
                            </div>
                            <h5 class="fw-bold mb-1">Invoice #@item.Id — @item.ContractorName</h5>
                            <p class="text-body mb-0">
                                Original Bid: <strong>M@(@item.OriginalProposalCost.ToString("N2"))</strong> | 
                                Actual Cost: <strong class="text-danger">M@(@item.TotalAmount.ToString("N2"))</strong>
                            </p>
                        </div>
                        <div class="text-center px-4 border-start border-end">
                            <h3 class="fw-bold text-danger mb-0">+@item.DeviationPercentage.ToString("F1")%</h3>
                            <small class="text-muted fw-bold">DEVIATION</small>
                        </div>
                        <div class="ps-4">
                            <button class="btn btn-danger btn-sm w-100 mb-2">Freeze Payment</button>
                            <button class="btn btn-outline-secondary btn-sm w-100">Review Details</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 clearbit-card clearbit-card-glass shadow-sm mx-auto" style="max-width: 600px;">
            <i data-lucide="shield-check" class="text-success mb-3" style="width: 48px; height: 48px; opacity: 0.5;"></i>
            <h4 class="fw-bold">No Risk Signals</h4>
            <p class="text-muted">All current infrastructural invoices are within safe deviation thresholds (under 5%).</p>
        </div>
    }
</div>
