@{
    ViewData["Title"] = "Integrity Monitoring Center";
}

<div class="db-container">
    <!-- Greeting & Header -->
    <div class="db-greeting d-flex justify-content-between align-items-end">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="db-badge bg-danger text-white">EXTERNAL AUDITOR</span>
                <span class="text-muted small fw-bold">Verification: Independent Oversight Active</span>
            </div>
            <h1>Audit & Integrity</h1>
            <p>Monitoring the Smart Evaluating Algorithm for procurement transparency.</p>
        </div>
        <div class="d-flex gap-2 mb-2">
            <a asp-action="AuditLogs" class="btn-brand text-decoration-none d-flex align-items-center gap-2">
                <i data-lucide="scroll-text" style="width: 18px; height: 18px;"></i>
                Full Audit Trail
            </a>
        </div>
    </div>

    <!-- Stat Grid -->
    <div class="db-grid mb-5">
        <div class="col-span-4">
            <div class="db-stat-card accent-auditor">
                <div class="stat-icon" style="background: rgba(239, 68, 68, 0.05);">
                    <i data-lucide="shield-alert" style="width: 20px; height: 20px; color: #EF4444;"></i>
                </div>
                <div class="stat-label">Anomaly Signals</div>
                <div class="stat-value">02</div>
                <div class="stat-delta">
                    <span class="stat-down"><i data-lucide="alert-circle"></i> High risk deviations</span>
                </div>
            </div>
        </div>
        <div class="col-span-4">
            <div class="db-stat-card">
                <div class="stat-icon" style="background: rgba(16, 185, 129, 0.05);">
                    <i data-lucide="gauge" style="width: 20px; height: 20px; color: #10B981;"></i>
                </div>
                <div class="stat-label">System Integrity</div>
                <div class="stat-value">99.99<span style="font-size: 0.9rem; color: var(--text-muted);">%</span></div>
                <div class="stat-delta">
                    <span class="text-muted">Algorithm hash verified</span>
                </div>
            </div>
        </div>
        <div class="col-span-4">
            <div class="db-stat-card">
                <div class="stat-icon" style="background: rgba(79, 70, 229, 0.05);">
                    <i data-lucide="database" style="width: 20px; height: 20px; color: var(--brand-primary);"></i>
                </div>
                <div class="stat-label">Logs Indexed</div>
                <div class="stat-value">14.2<span style="font-size: 0.9rem; color: var(--text-muted);">k</span></div>
                <div class="stat-delta">
                    <span class="stat-up"><i data-lucide="trending-up"></i> +1.2k today</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="db-grid">
        <div class="col-span-8">
            <div class="db-card overflow-hidden">
                <div class="db-card-body d-flex flex-column justify-content-center align-items-center text-center p-5" style="background: #F8FAFC;">
                    <div class="bg-white rounded-circle p-4 shadow-sm mb-4">
                        <i data-lucide="activity" class="text-brand" style="width: 48px; height: 48px;"></i>
                    </div>
                    <h4 class="fw-bold mb-2">Live Anomaly Detection</h4>
                    <p class="text-muted mb-4 mx-auto" style="max-width: 500px;">
                        The verification engine is currently scanning LSL 40M+ in active infrastructure contracts. No fraudulent patterns detected in the last 24 hours.
                    </p>
                    <div class="d-flex gap-3">
                        <a asp-action="FlaggedInvoices" class="btn btn-brand px-4 py-2 fw-bold">Review Risk Signals</a>
                        <a href="#" class="btn btn-light border px-4 py-2 fw-bold">Download Report</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-span-4">
            <div class="db-card">
                <div class="db-card-header">
                    <h5 class="db-card-title">Recent Audit Events</h5>
                </div>
                <div class="db-card-body p-0">
                    <div class="p-3 border-bottom d-flex gap-3">
                        <div class="small fw-bold">System / Login</div>
                        <p class="small text-muted mb-0">Admin logged in from Maseru Central Office</p>
                    </div>
                    <div class="p-3 border-bottom d-flex gap-3">
                        <div class="small fw-bold text-success">Algorithm / Pass</div>
                        <p class="small text-muted mb-0">Tender #402 evaluated (Score: 0.98)</p>
                    </div>
                    <div class="p-3 d-flex gap-3">
                        <div class="small fw-bold text-danger">Signal / Alert</div>
                        <p class="small text-muted mb-0">Duplicate invoice detected for Project #19</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

